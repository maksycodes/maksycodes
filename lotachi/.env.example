# Copy this file to .env.local for local development, and add the same
# values in your Vercel project settings for production.

# --- Contact emails shown on the site (optional overrides) ---
# If unset, the site falls back to hello@lotachi.com / providers@lotachi.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@lotachi.com
NEXT_PUBLIC_PROVIDER_EMAIL=providers@lotachi.com

# --- Formspree form endpoints ---
# Create a free account at https://formspree.io, create TWO separate forms
# (one for the model waitlist, one for the training-provider waitlist), and
# paste each form's ID below (the part after /f/ in your form endpoint).
# Keeping them separate makes it trivial to see the two lead lists apart in
# Formspree, in addition to the user_type field sent with every submission.
NEXT_PUBLIC_FORMSPREE_MODEL_FORM_ID=
NEXT_PUBLIC_FORMSPREE_PROVIDER_FORM_ID=
