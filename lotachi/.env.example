# Copy this file to .env.local for local development, and add the same
# values in your Vercel project settings for production.

# --- Contact emails shown on the site (optional overrides) ---
# If unset, the site falls back to hello@lotachi.com / providers@lotachi.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@lotachi.com
NEXT_PUBLIC_PROVIDER_EMAIL=providers@lotachi.com

# --- Formspree form endpoints ---
# Create a free account at https://formspree.io and create THREE separate
# forms (model waitlist, provider network, general contact), then paste each
# form's ID below (the part after /f/ in your form endpoint). The footer
# email-capture box also submits to the contact form, tagged
# source=footer_email_capture.
NEXT_PUBLIC_FORMSPREE_MODEL_FORM_ID=
NEXT_PUBLIC_FORMSPREE_PROVIDER_FORM_ID=
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=
