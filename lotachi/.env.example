# Copy this file to .env.local for local development, and add the same
# values in your Vercel project settings for production.

# --- Contact emails shown on the site (optional overrides) ---
# If unset, the site falls back to hello@lotachi.com / providers@lotachi.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@lotachi.com
NEXT_PUBLIC_PROVIDER_EMAIL=providers@lotachi.com

# --- Formspree form endpoints ---
# These are LOTACHI's live Formspree form IDs (the part after /f/ in
# https://formspree.io/f/<id>). The footer email-capture box also submits to
# the contact form, tagged source=footer_email_capture. To point at a
# different Formspree account/form, create it at https://formspree.io and
# replace the ID below — nothing else in the codebase needs to change.
NEXT_PUBLIC_FORMSPREE_MODEL_FORM_ID=mwlpobvd
NEXT_PUBLIC_FORMSPREE_PROVIDER_FORM_ID=mrpbqken
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=xbgloygr

# --- Google Analytics 4 ---
# PASTE YOUR GA4 MEASUREMENT ID HERE ONCE YOU'VE CREATED A GA4 PROPERTY.
# Format: G-XXXXXXXXXX (Admin -> Data Streams -> your web stream, in the
# GA4 property you create at https://analytics.google.com).
#
# Leave this blank to keep analytics fully disabled — with no ID set, no
# gtag script loads and nothing is sent to Google. This is intentionally
# NOT pre-filled with a placeholder/fake ID.
#
# Before relying on real GA4 data: this site does not yet have a
# cookie-consent banner. GA4 is wired with Consent Mode v2 defaulting to
# "denied", so no analytics cookies are set until a banner calls
# gtag('consent','update',{analytics_storage:'granted'}) — see
# src/app/layout.tsx and README.md "Analytics & UTM tracking".
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
